<?xml version="1.0" encoding="utf-8"?>
<!-- A day of the week and how many classes it has. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/routine_widget_day"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:layout_weight="1"
    android:background="@drawable/routine_widget_day"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingVertical="4dp">

    <TextView
        android:id="@+id/routine_widget_day_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/routine_widget_muted"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/routine_widget_day_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/routine_widget_on_surface"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
