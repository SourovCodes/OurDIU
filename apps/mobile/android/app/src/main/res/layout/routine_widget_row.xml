<?xml version="1.0" encoding="utf-8"?>
<!-- One class: its start, course (with the lab group or sections) and room. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/routine_widget_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="3dp"
    android:background="@drawable/routine_widget_row"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp"
    android:paddingVertical="7dp">

    <TextView
        android:id="@+id/routine_widget_row_time"
        android:layout_width="62dp"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:textColor="@color/routine_widget_muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/routine_widget_row_course"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/routine_widget_on_surface"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/routine_widget_row_room"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:ellipsize="end"
        android:maxWidth="110dp"
        android:maxLines="1"
        android:textColor="@color/routine_widget_muted"
        android:textSize="12sp" />
</LinearLayout>
