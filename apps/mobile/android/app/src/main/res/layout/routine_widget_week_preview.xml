<?xml version="1.0" encoding="utf-8"?>
<!-- The week widget's preview in the widget picker. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/routine_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/routine_widget_surface"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/routine_widget_title"
            android:text="Today · 67_B1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/routine_widget_on_surface"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/routine_widget_note"
            android:text="3 classes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:textColor="@color/routine_widget_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/routine_widget_days"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="2dp" android:layout_weight="1" android:background="@drawable/routine_widget_day" android:gravity="center_horizontal" android:orientation="vertical" android:paddingVertical="4dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sat" android:textColor="@color/routine_widget_on_surface" android:textSize="10sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2" android:textColor="@color/routine_widget_on_surface" android:textSize="14sp" android:textStyle="bold"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="2dp" android:layout_weight="1" android:background="@drawable/routine_widget_day" android:gravity="center_horizontal" android:orientation="vertical" android:paddingVertical="4dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sun" android:textColor="@color/routine_widget_on_surface" android:textSize="10sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2" android:textColor="@color/routine_widget_on_surface" android:textSize="14sp" android:textStyle="bold"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="2dp" android:layout_weight="1" android:background="@drawable/routine_widget_day_on" android:gravity="center_horizontal" android:orientation="vertical" android:paddingVertical="4dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mon" android:textColor="@color/routine_widget_on_teal" android:textSize="10sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3" android:textColor="@color/routine_widget_on_teal" android:textSize="14sp" android:textStyle="bold"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="2dp" android:layout_weight="1" android:background="@drawable/routine_widget_day" android:gravity="center_horizontal" android:orientation="vertical" android:paddingVertical="4dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tue" android:textColor="@color/routine_widget_on_surface" android:textSize="10sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="–" android:textColor="@color/routine_widget_on_surface" android:textSize="14sp" android:textStyle="bold"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="2dp" android:layout_weight="1" android:background="@drawable/routine_widget_day" android:gravity="center_horizontal" android:orientation="vertical" android:paddingVertical="4dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Wed" android:textColor="@color/routine_widget_on_surface" android:textSize="10sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3" android:textColor="@color/routine_widget_on_surface" android:textSize="14sp" android:textStyle="bold"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="2dp" android:layout_weight="1" android:background="@drawable/routine_widget_day" android:gravity="center_horizontal" android:orientation="vertical" android:paddingVertical="4dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Thu" android:textColor="@color/routine_widget_on_surface" android:textSize="10sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="–" android:textColor="@color/routine_widget_on_surface" android:textSize="14sp" android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/routine_widget_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:background="@drawable/routine_widget_row"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="7dp">
            <TextView android:layout_width="62dp" android:layout_height="wrap_content" android:text="8:30" android:textColor="@color/routine_widget_muted" android:textSize="12sp"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:text="Computer Networks" android:textColor="@color/routine_widget_on_surface" android:textSize="13sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="KT-222" android:textColor="@color/routine_widget_muted" android:textSize="12sp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:background="@drawable/routine_widget_row_now"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="7dp">
            <TextView android:layout_width="62dp" android:layout_height="wrap_content" android:text="Now" android:textColor="@color/routine_widget_on_container" android:textSize="12sp"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:text="Software Engineering" android:textColor="@color/routine_widget_on_container" android:textSize="13sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="KT-208" android:textColor="@color/routine_widget_on_container" android:textSize="12sp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:background="@drawable/routine_widget_row"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="7dp">
            <TextView android:layout_width="62dp" android:layout_height="wrap_content" android:text="2:30" android:textColor="@color/routine_widget_muted" android:textSize="12sp"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:text="Networks Lab · B1 lab" android:textColor="@color/routine_widget_on_surface" android:textSize="13sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="G1-014" android:textColor="@color/routine_widget_muted" android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/routine_widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/routine_widget_muted"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
