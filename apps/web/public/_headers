# Workers Static Assets. Files under /assets/ are content-hashed by Vite, so a new
# build gets new URLs and browsers can keep these forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Not hashed, so not forever. A day rather than revalidating on every request,
# which is slower once the Worker's cache is on (docs/PLAN.md, decision 62).
/favicon.svg
  Cache-Control: public, max-age=86400
/favicon.ico
  Cache-Control: public, max-age=86400
/og.png
  Cache-Control: public, max-age=86400
/sourov.webp
  Cache-Control: public, max-age=86400
/cover-page/*
  Cache-Control: public, max-age=86400
