{
  "extends": "../../tsconfig.base.json",
  // The API tests' made-up routine files, uploaded by the routine tests.
  "include": [
    "e2e/**/*",
    "../api/test/cse-routine-pdf.ts",
    "../api/test/eee-routine-pdf.ts",
    "../api/test/swe-routine-xlsx.ts"
  ],
  "compilerOptions": {
    "composite": true,
    // Playwright runs in Node, but `page.evaluate` callbacks run in the browser.
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["node"]
  }
}
