{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The whole platform is one Worker: React Router pages, and the API (@ourdiu/api)
  // under /api/*, called in-process by loaders and actions. See workers/app.ts.
  "name": "ourdiu",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-09-01",
  // Required by Better Auth (AsyncLocalStorage) and node:crypto.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Run next to D1 rather than at the visitor's edge: a page makes several D1 round
  // trips, the visitor only one.
  "placement": { "mode": "smart" },
  "vars": {
    // The public site. Auth runs on this origin and trusts only it.
    // CI sets the production value at deploy time (`--var SITE_URL:…`).
    "SITE_URL": "http://localhost:5173",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ourdiu",
      // Production. Local dev and tests use a local copy, whatever the id.
      "database_id": "bb0a53e5-8368-4779-b01d-bfb313037c6d",
      // Migrations are generated by drizzle-kit from the schema in apps/api.
      "migrations_dir": "../api/migrations",
    },
  ],
  "r2_buckets": [
    {
      // Uploaded files of every product, under a prefix each.
      "binding": "BUCKET",
      "bucket_name": "ourdiu-files",
    },
  ],
}
