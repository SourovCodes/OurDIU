{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The whole site is one Worker: React Router pages, and the API (@ourdiu/api) under
  // /api/*, called in-process by loaders and actions. See workers/app.ts.
  "name": "ourdiu",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-09-01",
  // Required by Better Auth (AsyncLocalStorage) and node:crypto.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Run next to D1 (APAC) rather than at the visitor's edge: a page makes several
  // D1 round trips, the visitor only one.
  "placement": { "mode": "smart" },
  "vars": {
    // The public site. Auth runs on this origin and trusts only it, and its domain
    // goes in the watermark on public PDFs.
    // CI sets the production value at deploy time (`--var SITE_URL:…`).
    "SITE_URL": "http://localhost:5173",
    // Origin of the R2 bucket's public custom domain, where published papers'
    // watermarked copies are read from. Empty locally: files go through the API.
    // CI sets the production value at deploy time (`--var FILES_URL:…`).
    "FILES_URL": "",
    // AI analysis of uploads: PDFs are compressed (only to cut Gemini's input cost),
    // then read by Gemini. Published papers are watermarked by the same PDF processor.
    // Keys are the GEMINI_API_KEY and COMPRESSOR_API_KEY secrets.
    "PDF_PROCESSOR_URL": "https://pdf-processor.diuqbank.com",
    "GEMINI_MODEL": "gemini-3.8-flash",
  },
  // Storage and queues are the question bank's existing production resources
  // (from diuqbank.com), adopted as they are: its data needs no copying, and the
  // migrations here continue its history. See "Cutover" in docs/PLAN.md.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "questionbank",
      // Production. Local dev and tests use a local copy, whatever the id.
      "database_id": "ad50a07f-3aed-4006-9974-78df2b9bcfc6",
      // Migrations are generated by drizzle-kit from the schema in apps/api.
      "migrations_dir": "../api/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "questionbank-papers",
    },
  ],
  // Request limits for the API's costly or spammable endpoints: per user (the API's
  // rate-limit middleware), or per page token for view counts (the API's
  // lib/view-token.ts). Never per IP address: most visitors share a few campus
  // addresses.
  // Counted per Cloudflare location, so they are loose caps against abuse, not exact
  // quotas. Periods can only be 10 or 60 seconds.
  "ratelimits": [
    // Uploads, per user: each one is compressed and read by Gemini.
    {
      "name": "UPLOAD_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
    // Likes, dislikes and removing them, per user.
    {
      "name": "VOTE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 },
    },
    // Reports, per user.
    {
      "name": "REPORT_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 10, "period": 60 },
    },
    // View counts, per question page token and page: a page load counts each page
    // once, so a script can't replay one token for the hour it is valid.
    {
      "name": "VIEW_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 1, "period": 60 },
    },
  ],
  // Background work with retries, run by the API's queue handler (via workers/app.ts):
  // - uploads are analysed (compress → Gemini);
  // - published papers get a watermarked copy, the public download (PDF processor).
  // Both call the PDF processor, so each consumer runs at most 5 jobs at once; bursts
  // wait in the queue instead of overloading it.
  "queues": {
    "producers": [
      { "binding": "ANALYSIS_QUEUE", "queue": "qb-submission-analysis" },
      { "binding": "WATERMARK_QUEUE", "queue": "qb-pdf-watermark" },
    ],
    "consumers": [
      {
        "queue": "qb-submission-analysis",
        "max_batch_size": 1,
        "max_concurrency": 5,
        "max_retries": 3,
        "retry_delay": 30,
      },
      {
        "queue": "qb-pdf-watermark",
        "max_batch_size": 1,
        "max_concurrency": 5,
        "max_retries": 3,
        "retry_delay": 30,
      },
    ],
  },
}
