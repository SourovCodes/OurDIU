{
  "name": "ourdiu",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "pnpm --filter @ourdiu/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @ourdiu/web test:e2e",
    "openapi": "pnpm --filter @ourdiu/api openapi",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "db:generate": "pnpm --filter @ourdiu/api db:generate",
    "db:migrate": "pnpm --filter @ourdiu/api db:migrate:local",
    "db:seed": "pnpm --filter @ourdiu/api db:seed:local",
    "make-admin": "pnpm --filter @ourdiu/api make-admin",
    "student-ids-from-names": "pnpm --filter @ourdiu/api student-ids-from-names"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "catalog:",
    "typescript-eslint": "^8.70.1"
  }
}
